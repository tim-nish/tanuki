#!/usr/bin/env bash
# Fixture for the journey append (story 5.12 / issue #298, spec-den-distill
# §4): accepting a lesson candidate appends ONE entry to the EMITTING repo's
# docs/journey.md — date, the concrete episode as an atomic fact (authored
# at the accept, never generated by the tool), the finding/issue ids, and
# the hub lesson slug — and the receipt names the journey append alongside
# the emitted file path. Unset contribute_back stays byte-identical: no
# journey write, no journey file required. The tracked docs/journey.md
# exists with the entry-shape / append-only header (AC1).
set -euo pipefail

fail() { echo "FAIL: $1" >&2; exit 1; }
pass() { echo "ok: $1"; }

here="$(cd "$(dirname "$0")/.." && pwd)"   # tools/
repo="$(cd "$here/.." && pwd)"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
export TANUKI_ROOT="$tmp/root"
# The tool resolves ITS OWN repo root for the journey append — run a COPY
# inside a throwaway tree (the test-publication-boundary pattern) so the
# append lands there, never in this checkout.
mkdir -p "$tmp/repo/tools"
cp "$here/tanuki-ledger" "$tmp/repo/tools/tanuki-ledger"
L=("$tmp/repo/tools/tanuki-ledger" --target t)

mkdir -p "$TANUKI_ROOT/scenarios" "$TANUKI_ROOT/t/events/r1" "$tmp/staging"
cat > "$TANUKI_ROOT/t/events/r1/manifest.json" <<'EOF'
{"run":"r1","target":"t","results":[{"scenario":"s1","status":"ok"}]}
EOF
template="$tmp/intake.md"
printf -- '---\nslug: {slug}\n---\n\n{body}\n' > "$template"

"${L[@]}" init > /dev/null 2>&1 || true
"${L[@]}" upsert-finding --title "Chronic lesson" --kind friction \
  --evidence "r1/s1#1" > /dev/null
"${L[@]}" upsert-finding --match F1 --evidence "r1/s1#2" > /dev/null
"${L[@]}" upsert-finding --match F1 --evidence "r1/s1#3" > /dev/null
"${L[@]}" upsert-finding --title "Broad pattern" --kind gap \
  --evidence "r1/s1#4,r1/s2#1" > /dev/null

# --- AC1: the tracked journey doc exists with the contract header --------------
j_real="$repo/docs/journey.md"
[ -f "$j_real" ] || fail "docs/journey.md must exist in the repo (AC1)"
grep -qi "append-only" "$j_real" || fail "the header must state the append-only rule"
grep -q "never edited retroactively" "$j_real" \
  || fail "the header must state that entries are harvest pins, never edited"
grep -q "Entry shape" "$j_real" || fail "the header must state the entry shape"
pass "AC1: tracked docs/journey.md carries the entry-shape / append-only header"

# --- AC4: contribute_back unset — no journey write, no journey file required ---
"${L[@]}" distill --list > /dev/null || fail "--list must work unconfigured"
"${L[@]}" distill --id F1 --episode "an episode" 2>/dev/null \
  && fail "emit must refuse when unconfigured" || true
[ ! -e "$tmp/repo/docs" ] \
  || fail "unset contribute_back must write no journey file (AC4)"
pass "AC4: unset config — nothing written, no journey file required"

# --- AC2: accept appends one entry and the receipt names both writes -----------
python3 -c '
import json, os
p = os.environ["TANUKI_ROOT"] + "/scenarios/t.scenarios.json"
d = {"target": "t", "scenarios": [],
     "defaults": {"contribute_back": {"path": "'"$tmp/staging"'",
                                      "schema": "'"$template"'"}}}
json.dump(d, open(p, "w"))
'
out="$("${L[@]}" distill --id F1 --issues "#298" \
  --episode "The consolidator hit the same retry mask 3 times in r1")" \
  || fail "a configured accept must emit"
echo "$out" | grep -q "contributed F1 -> $tmp/staging/tanuki-t-f1.md" \
  || fail "the receipt must name the emitted file path: $out"
echo "$out" | grep -q "journey: appended $tmp/repo/docs/journey.md" \
  || fail "the receipt must name the journey append alongside it: $out"
j="$tmp/repo/docs/journey.md"
[ -f "$j" ] || fail "the journey doc must be created (with header) when absent"
grep -qi "append-only" "$j" || fail "a self-created journey doc must carry the header"
grep -qE "^- [0-9]{4}-[0-9]{2}-[0-9]{2} — The consolidator hit the same retry mask 3 times in r1 \(F1, #298; lesson: tanuki-t-f1\)$" "$j" \
  || fail "the entry must carry date, episode, finding+issue ids, slug: $(cat "$j")"
[ "$(grep -c "^- " "$j")" = 1 ] || fail "exactly ONE entry per accept"
pass "AC2: one entry appended (date, episode, F1+#298, slug); receipt names both"

# --- append-only mechanics: a second accept appends, never rewrites ------------
"${L[@]}" distill --id F2 --episode $'seen across\ns1 and s2' > /dev/null \
  || fail "a second accept must emit"
[ "$(grep -c "^- " "$j")" = 2 ] || fail "the second accept must APPEND"
[ "$(grep -ci "append-only" "$j")" = 1 ] || fail "the header must render once"
grep -q "The consolidator hit the same retry mask 3 times in r1" "$j" \
  || fail "earlier entries are never edited retroactively"
grep -qE "— seen across s1 and s2 \(F2; lesson: tanuki-t-f2\)$" "$j" \
  || fail "an authored line break must collapse — one entry, one line: $(cat "$j")"
pass "append-only: second accept appends one line; earlier entries untouched"

# --- a refused emit appends nothing --------------------------------------------
"${L[@]}" distill --id F1 --episode "again" 2>/dev/null \
  && fail "re-emit must be refused" || true
[ "$(grep -c "^- " "$j")" = 2 ] || fail "a refused accept must not touch the journey"
pass "refused emit: journey untouched"

echo "all checks passed"
