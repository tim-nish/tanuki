#!/usr/bin/env bash
# Fixture for the reach axis (story 5.3 / issue #299).
#
# Loop run loop-20260726-201337 had 4 of 5 verify-set scenarios short-circuit
# at 3-13 turns. All reported status: ok, probe: undeclared. The two-axis rule
# kept `ok` from READING healthy, but record-run yield and record-cycle
# quiet-accounting consume status/yield only — so the arithmetic treated four
# executions that never entered the plugin flow as valid ones, and a second
# such run could have reported converged: true on a drive that never touched
# the code under test.
#
# Asserts:
#   1. a declared probe answers reach: matched -> reached, unmatched ->
#      unreached (the charter itself names what counts as entering the flow);
#   2. with no probe, the turns floor decides, and the floor is CONFIGURABLE —
#      one run's evidence is not a threshold;
#   3. reach is a THIRD field, never merged into status or probe;
#   4. a real drive records it in the manifest for every result path;
#   5. an unreached execution is marked distinctly in the run summary —
#      silence must not read as a clean result.
set -euo pipefail

fail() { echo "FAIL: $1" >&2; exit 1; }
pass() { echo "ok: $1"; }

here="$(cd "$(dirname "$0")/.." && pwd)"   # tools/
drive="$here/tanuki-drive"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

# --- 1-3: unit-check evaluate_reach -------------------------------------------
python3 - "$drive" <<'PY' || fail "evaluate_reach"
import importlib.machinery, importlib.util, sys
loader = importlib.machinery.SourceFileLoader("td", sys.argv[1])
spec = importlib.util.spec_from_loader("td", loader)
td = importlib.util.module_from_spec(spec); loader.exec_module(td)
cfg = dict(td.CONFIG_DEFAULTS)

# 1. a declared probe is the authority — the charter named what counts
assert td.evaluate_reach({}, [], "reached", 3, cfg) == "reached", \
    "a matched probe means reached even at a low turn count"
assert td.evaluate_reach({}, [], "short_circuited", 40, cfg) == "unreached", \
    "an unmatched probe means unreached even at a high turn count"

# 2. no probe -> the turns floor, and it is configurable
assert td.evaluate_reach({}, [], "undeclared", 3, cfg) == "unreached"
assert td.evaluate_reach({}, [], "undeclared", 34, cfg) == "reached"
loose = dict(cfg, reach_min_turns=2)
assert td.evaluate_reach({}, [], "undeclared", 3, loose) == "reached", \
    "the floor must be configurable, not the observed run baked in"
strict = dict(cfg, reach_min_turns=50)
assert td.evaluate_reach({}, [], "undeclared", 34, strict) == "unreached"

# a scenario that never reported turns exercised nothing
assert td.evaluate_reach({}, [], "undeclared", None, cfg) == "unreached"

# 3. reach never collapses into the other axes: every pairing is expressible
assert td.evaluate_reach({}, [], "undeclared", 3, cfg) == "unreached"   # ok + undeclared + unreached
assert td.evaluate_reach({}, [], "undeclared", 40, cfg) == "reached"
assert td.render_reach({"reach": "unreached"}).strip().startswith("UNREACHED")
assert td.render_reach({"reach": "reached"}) == "", "a reached run adds no noise"
assert td.render_reach({}) == "", "a pre-axis result is not retro-flagged"
PY
pass "evaluate_reach: probe decides, else a configurable turns floor; third axis, never merged"

# --- 4-5: a real drive records and renders it ---------------------------------
git init -q "$tmp/plugin" && git -C "$tmp/plugin" config user.email t@e \
  && git -C "$tmp/plugin" config user.name t
git -C "$tmp/plugin" checkout -qb main && echo x > "$tmp/plugin/x" \
  && git -C "$tmp/plugin" add -A && git -C "$tmp/plugin" commit -qm base

mkdir -p "$tmp/bin"
# Stub claude: one turn, no flow entered — the degenerate shape #299 records.
cat > "$tmp/bin/claude" <<'EOF'
#!/bin/sh
cat <<'JSON'
{"type":"result","subtype":"success","num_turns":1,"duration_ms":10,"total_cost_usd":0.001,"is_error":false,"result":"done"}
JSON
EOF
chmod +x "$tmp/bin/claude"
export PATH="$tmp/bin:$PATH"

cat > "$tmp/scenarios.json" <<'EOF'
{"scenarios": [{"id": "solo", "charter": "c", "prompt": "p", "max_turns": 3}]}
EOF
export TANUKI_ROOT="$tmp/root"
out="$("$drive" --target t --plugin "$tmp/plugin" --scenarios "$tmp/scenarios.json" \
       --run rreach --timeout 60 2>&1)" || true

python3 - "$tmp/root/t/events/rreach/manifest.json" <<'PY' || fail "manifest reach"
import json, sys
r = json.load(open(sys.argv[1]))["results"][0]
assert r["reach"] == "unreached", r
assert r["status"] == "ok", "status is untouched — the axes are independent"
assert r["probe"] == "undeclared", "probe is untouched too"
PY
pass "a real drive records reach in the manifest, leaving status and probe untouched"

echo "$out" | grep -q "UNREACHED" \
  || fail "the run summary did not mark the unreached scenario distinctly"
pass "an unreached execution is marked in the run summary"
